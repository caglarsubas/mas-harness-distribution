{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "definitions": {
    "dependencyValues": {
      "additionalProperties": false,
      "properties": {
        "global": {
          "$ref": "#/definitions/global"
        }
      },
      "required": ["global"],
      "type": "object"
    },
    "global": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "enum": ["amd64", "arm64"]
        },
        "connectivity": {
          "enum": ["airgap", "bridge", "connected", "silo"]
        },
        "images": {
          "$ref": "#/definitions/images"
        },
        "namespace": {
          "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$",
          "type": "string"
        },
        "platform": {
          "enum": ["k3s", "kubernetes", "openshift"]
        },
        "profileId": {
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "type": "string"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "storageClassName": {
          "pattern": "^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": ["profileId", "namespace", "platform", "architecture", "connectivity", "storageClassName", "images", "resources"],
      "type": "object"
    },
    "images": {
      "additionalProperties": false,
      "properties": {
        "aiGateway": {"pattern": "^[a-z0-9.-]+/[a-z0-9-]+@sha256:[0-9a-f]{64}$", "type": "string"},
        "controlOverview": {"pattern": "^[a-z0-9.-]+/[a-z0-9-]+@sha256:[0-9a-f]{64}$", "type": "string"},
        "dataIntegration": {"pattern": "^[a-z0-9.-]+/[a-z0-9-]+@sha256:[0-9a-f]{64}$", "type": "string"},
        "modelInference": {"pattern": "^[a-z0-9.-]+/[a-z0-9-]+@sha256:[0-9a-f]{64}$", "type": "string"},
        "runtimeInfrastructure": {"pattern": "^[a-z0-9.-]+/[a-z0-9-]+@sha256:[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["runtimeInfrastructure", "modelInference", "aiGateway", "dataIntegration", "controlOverview"],
      "type": "object"
    },
    "module": {
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}},
      "required": ["enabled"],
      "type": "object"
    },
    "modules": {
      "additionalProperties": false,
      "properties": {
        "aiGateway": {"$ref": "#/definitions/module"},
        "controlOverview": {"$ref": "#/definitions/module"},
        "dataIntegration": {"$ref": "#/definitions/module"},
        "modelInference": {"$ref": "#/definitions/module"},
        "runtimeInfrastructure": {"$ref": "#/definitions/module"}
      },
      "required": ["runtimeInfrastructure", "modelInference", "aiGateway", "dataIntegration", "controlOverview"],
      "type": "object"
    },
    "resource": {
      "additionalProperties": false,
      "properties": {
        "limitCpu": {"type": "string"},
        "limitMemory": {"type": "string"},
        "requestCpu": {"type": "string"},
        "requestMemory": {"type": "string"}
      },
      "required": ["requestCpu", "requestMemory", "limitCpu", "limitMemory"],
      "type": "object"
    },
    "resources": {
      "additionalProperties": false,
      "properties": {
        "aiGateway": {"$ref": "#/definitions/resource"},
        "controlOverview": {"$ref": "#/definitions/resource"},
        "dataIntegration": {"$ref": "#/definitions/resource"},
        "modelInference": {"$ref": "#/definitions/resource"},
        "runtimeInfrastructure": {"$ref": "#/definitions/resource"}
      },
      "required": ["runtimeInfrastructure", "modelInference", "aiGateway", "dataIntegration", "controlOverview"],
      "type": "object"
    }
  },
  "properties": {
    "ai-gateway": {"$ref": "#/definitions/dependencyValues"},
    "control-overview": {"$ref": "#/definitions/dependencyValues"},
    "data-integration": {"$ref": "#/definitions/dependencyValues"},
    "global": {"$ref": "#/definitions/global"},
    "model-inference": {"$ref": "#/definitions/dependencyValues"},
    "modules": {"$ref": "#/definitions/modules"},
    "runtime-infrastructure": {"$ref": "#/definitions/dependencyValues"}
  },
  "required": ["global", "modules"],
  "type": "object"
}
